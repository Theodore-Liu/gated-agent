# Copy to .env and fill in. .env is gitignored — NEVER commit real keys.
# No .env at all is fine: the agent then runs in offline stub mode.

# Alpaca paper-trading account (not needed for stub mode)
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_PAPER=true

# Real order submission needs this EXPLICITLY set to 1 in the environment
# (a second, independent gate on top of the --live flag). Keep it 0.
ALPACA_HACKATHON_LIVE=0

# Optional: path override for the Alpaca CLI binary (default: bin/alpaca.exe,
# then "alpaca" on PATH). Download: https://github.com/alpacahq/cli/releases
# ALPACA_CLI=C:\path\to\alpaca.exe

# Optional: Anthropic key for the red-team LLM loop (stubbed until wired)
ANTHROPIC_API_KEY=your_key_here
