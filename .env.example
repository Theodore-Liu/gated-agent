# Copy to .env and fill in. .env is gitignored — NEVER commit real keys.

# Alpaca paper-trading account (not needed for --dry-run)
ALPACA_API_KEY_ID=your_paper_key_id_here
ALPACA_API_SECRET_KEY=your_paper_secret_here
ALPACA_PAPER=true

# Optional: Anthropic key for the red-team LLM loop (stubbed until wired)
ANTHROPIC_API_KEY=your_key_here
